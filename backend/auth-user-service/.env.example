# Local development placeholders for auth-user-service.
# Copy these names into your IDE/run configuration and provide real values locally.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/cgi_flow_auth
SPRING_DATASOURCE_USERNAME=postgres
POSTGRES_PASSWORD=<your-local-postgres-password>

KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/cgi-flow
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8085
KEYCLOAK_REALM=cgi-flow
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<your-local-keycloak-admin-password>
