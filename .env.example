# Local development overrides for CGI-FLOW.
# Copy to `.env` in the repo root and adjust values for your machine.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cgi_flow_auth

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8085
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/cgi-flow

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka

PLANNING_DATABASE_URL=jdbc:postgresql://localhost:55432/cgi_flow_planning
SECURITY_DEV_ADMIN_BYPASS=false
VITE_PLANNING_DEV_ADMIN_BYPASS=false
